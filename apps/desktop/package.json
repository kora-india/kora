{
  "name": "@schoolos/desktop",
  "version": "1.0.0",
  "private": true,
  "author": "SchoolOS Team <support@schoolos.com>",
  "description": "Kora Desktop Client for macOS and Windows",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -w",
    "dev:app": "tsc && cp src/*.html dist/ && electron .",
    "build": "tsc && cp src/*.html dist/",
    "type-check": "tsc --noEmit",
    "package:mac": "pnpm build && electron-builder --mac --arm64 --x64",
    "package:mac:arm": "pnpm build && electron-builder --mac --arm64",
    "package:mac:intel": "pnpm build && electron-builder --mac --x64",
    "package:win": "pnpm build && electron-builder --win --x64",
    "package:all": "pnpm build && electron-builder -mw"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.4.0"
  }
}
