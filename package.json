{
  "name": "schoolos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "db:generate": "cd packages/db && pnpm prisma generate",
    "db:migrate": "cd packages/db && pnpm prisma migrate dev",
    "db:deploy": "cd packages/db && pnpm prisma migrate deploy",
    "db:status": "cd packages/db && pnpm prisma migrate status",
    "db:seed": "cd packages/db && pnpm seed",
    "db:dr:sync": "cd packages/db && pnpm db:dr:sync",
    "db:dr:verify": "cd packages/db && pnpm db:dr:verify",
    "db:dr:dump": "cd packages/db && pnpm db:dr:dump",
    "db:push": "cd packages/db && pnpm prisma db push",
    "desktop:dev": "pnpm --filter @schoolos/desktop dev:app",
    "desktop:build": "pnpm --filter @schoolos/desktop build",
    "desktop:package:mac": "pnpm --filter @schoolos/desktop package:mac",
    "desktop:package:mac:arm": "pnpm --filter @schoolos/desktop package:mac:arm",
    "desktop:package:win": "pnpm --filter @schoolos/desktop package:win",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
