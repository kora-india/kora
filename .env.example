# ─── Database ──────────────────────────────────────────────────────────────────
# Neon:      postgresql://user:pass@ep-xxx.neon.tech/schoolos?sslmode=require
# Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Local dev: postgresql://postgres:password@localhost:5432/schoolos
DATABASE_URL="postgresql://postgres:password@localhost:5432/schoolos"
DIRECT_URL="postgresql://postgres:password@localhost:5432/schoolos"
# Multi-Region Standby / Disaster Recovery (Secondary Region)
BACKUP_DATABASE_URL="postgresql://user:password@secondary-region-pooler.neon.tech/neondb?sslmode=require"
BACKUP_DIRECT_URL="postgresql://user:password@secondary-region-direct.neon.tech/neondb?sslmode=require"

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="your-super-secret-key-min-32-chars"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"

# Production: https://your-domain.com  |  Dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Email (SMTP — used for password reset) ────────────────────────────────────
# Any SMTP provider works (Gmail app password, SES SMTP, Mailgun, Postmark, etc.)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
# Optional: defaults to SMTP_USER if unset
SMTP_FROM="no-reply@your-domain.com"

# ─── Payments (Razorpay) — plan purchases and renewals ─────────────────────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ─── Scheduled jobs — Vercel cron sends this as a Bearer token ────────────────
# Without it the monthly fee and late fee jobs refuse to run.
CRON_SECRET="a-long-random-string"

# ─── Redis (Upstash) — rate limits and caching ────────────────────────────────
# Without it both fall back to per-instance memory, which doesn't protect a
# deployed app.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ─── Uploads (Cloudinary) — school logos ──────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── AI timetable (optional) ──────────────────────────────────────────────────
GEMINI_API_KEY=""

# ─── Client IP behind your own proxy (not needed on Vercel) ───────────────────
# Rate limits key on the client's IP. Set ONE of these when self-hosting:
# CLIENT_IP_HEADER="cf-connecting-ip"   # a header your proxy always sets
# TRUSTED_PROXY_COUNT="1"               # proxies in front of the app
