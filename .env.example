# ─── Database ──────────────────────────────────────────────────────────────────
# Neon:      postgresql://user:pass@ep-xxx.neon.tech/schoolos?sslmode=require
# Supabase:  postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
# Local dev: postgresql://postgres:password@localhost:5432/schoolos
DATABASE_URL="postgresql://postgres:password@localhost:5432/schoolos"

# ─── Auth (NextAuth v5) ────────────────────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars"

# Production: https://your-domain.com  |  Dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Email (SMTP — used for password reset) ────────────────────────────────────
# Any SMTP provider works (Gmail app password, SES SMTP, Mailgun, Postmark, etc.)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
# Optional: defaults to SMTP_USER if unset
SMTP_FROM="no-reply@your-domain.com"
