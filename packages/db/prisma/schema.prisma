generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id               String               @id @default(cuid())
  name             String
  subdomain        String               @unique
  address          String?
  pincode          String?
  city             String?
  state            String?
  country          String?
  expectedStudents Int?
  expectedStaff    Int?
  phone            String?
  email            String?
  logoUrl          String?
  plan             SubscriptionPlan     @default(FREE)
  isActive         Boolean              @default(true)
  lateFeeEnabled   Boolean              @default(false)
  lateFeeAmount    Decimal?             @db.Decimal(10, 2)
  lateFeeFrequency String?              @default("MONTHLY")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  academicSessions AcademicSession[]
  assignments      Assignment[]
  attendances      Attendance[]
  classes          Class[]
  feeCharges       FeeCharge[]
  feeComponents    FeeComponent[]
  feeStructures    FeeStructure[]
  fees             Fee[]
  notices          Notice[]
  paymentTxs       PaymentTransaction[]
  payments         Payment[]
  sections         Section[]
  students         Student[]
  subscription     Subscription?
  teachers         Teacher[]
  staff            Staff[]
  users            User[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  vehicles         Vehicle[]
  transportRoutes  TransportRoute[]
  studentTransports StudentTransport[]
  teacherSections  TeacherSection[]

  @@map("schools")
}

model Subscription {
  id                 String             @id @default(cuid())
  schoolId           String             @unique
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(TRIAL)
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  school             School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model PlanLimit {
  id               String           @id @default(cuid())
  plan             SubscriptionPlan @unique
  maxStudents      Int
  maxTeachers      Int
  maxClasses       Int
  analyticsEnabled Boolean          @default(false)
  customBranding   Boolean          @default(false)
  prioritySupport  Boolean          @default(false)

  @@map("plan_limits")
}

model User {
  id               String       @id @default(cuid())
  schoolId         String?
  email            String       @unique
  password         String
  name             String
  role             UserRole     @default(TEACHER)
  image            String?
  phone            String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resetToken       String?      @unique
  resetTokenExpiry DateTime?
  attendances      Attendance[]
  notices          Notice[]
  teacher          Teacher?
  recordedExpenses Expense[]
  school           School?      @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
  @@index([email])
  @@map("users")
}

model Class {
  id                 String              @id @default(cuid())
  schoolId           String
  name               String
  grade              Int
  classTeacherId     String?
  classTeacher       Teacher?            @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assignments        Assignment[]
  attendances        Attendance[]
  classFeeStructures ClassFeeStructure[]
  school             School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fees               Fee[]
  sections           Section[]
  students           Student[]
  teachers           Teacher[]           @relation("LegacyAssignedClass")
  teacherSections    TeacherSection[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([classTeacherId])
  @@map("classes")
}

model Section {
  id              String           @id @default(cuid())
  schoolId        String
  classId         String
  name            String
  createdAt       DateTime         @default(now())
  assignments     Assignment[]
  attendances     Attendance[]
  class           Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students        Student[]
  teachers        Teacher[]        @relation("LegacyAssignedSection")
  teacherSections TeacherSection[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("sections")
}

model Student {
  id              String                 @id @default(cuid())
  schoolId        String
  classId         String
  sectionId       String
  rollNumber      String
  admissionNumber String                 @unique
  name            String
  dateOfBirth     DateTime?
  gender          Gender                 @default(MALE)
  parentName      String
  parentPhone     String
  parentEmail     String?
  address         String?
  bloodGroup      String?
  pincode         String?
  city            String?
  state           String?
  photoUrl        String?
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  advanceLedgers  AdvanceLedger[]
  attendances     Attendance[]
  feeCharges      FeeCharge[]
  fees            Fee[]
  paymentTxs      PaymentTransaction[]
  feeAssignments  StudentFeeAssignment[]
  feeOverrides    StudentFeeOverride[]
  transports      StudentTransport[]
  class           Class                  @relation(fields: [classId], references: [id])
  school          School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section         Section                @relation(fields: [sectionId], references: [id])

  @@unique([schoolId, rollNumber, classId])
  @@index([schoolId])
  @@index([classId])
  @@index([schoolId, isActive, classId])
  @@index([schoolId, isActive, name])
  @@map("students")
}

model Teacher {
  id                String           @id @default(cuid())
  schoolId          String
  userId            String           @unique
  name              String
  email             String
  phone             String?
  subject           String
  qualification     String?
  salary            Decimal?         @db.Decimal(10, 2)
  joiningDate       DateTime?
  assignedClassId   String?
  assignedSectionId String?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  assignments       Assignment[]
  assignedClass     Class?           @relation("LegacyAssignedClass", fields: [assignedClassId], references: [id])
  assignedSection   Section?         @relation("LegacyAssignedSection", fields: [assignedSectionId], references: [id])
  classTeacherOf    Class[]          @relation("ClassTeacher")
  assignedSections  TeacherSection[]
  school            School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([assignedClassId])
  @@map("teachers")
}

model TeacherSection {
  id        String   @id @default(cuid())
  schoolId  String
  teacherId String
  classId   String
  sectionId String
  createdAt DateTime @default(now())

  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId, sectionId])
  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([sectionId])
  @@map("teacher_sections")
}

model Staff {
  id            String    @id @default(cuid())
  schoolId      String
  name          String
  phone         String
  occupation    String
  qualification String?
  email         String?
  address       String?
  salary        Decimal?  @db.Decimal(10, 2)
  joiningDate   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("staff")
}

model Attendance {
  id         String           @id @default(cuid())
  schoolId   String
  studentId  String
  classId    String
  sectionId  String
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  markedById String
  remarks    String?
  createdAt  DateTime         @default(now())
  class      Class            @relation(fields: [classId], references: [id])
  markedBy   User             @relation(fields: [markedById], references: [id])
  school     School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section    Section          @relation(fields: [sectionId], references: [id])
  student    Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@index([classId, sectionId, date])
  @@index([schoolId, classId, date, status])
  @@map("attendances")
}

model Fee {
  id         String    @id @default(cuid())
  schoolId   String
  studentId  String
  classId    String
  feeType    String
  amount     Decimal   @db.Decimal(10, 2)
  dueDate    DateTime  @db.Date
  status     FeeStatus @default(PENDING)
  paidAt     DateTime?
  paidAmount Decimal?  @db.Decimal(10, 2)
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  class      Class     @relation(fields: [classId], references: [id])
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments   Payment[]

  @@index([schoolId])
  @@index([studentId])
  @@index([status])
  @@map("fees")
}

model Payment {
  id        String   @id @default(cuid())
  schoolId  String
  feeId     String
  amount    Decimal  @db.Decimal(10, 2)
  paidAt    DateTime @default(now())
  method    String   @default("CASH")
  receiptNo String   @unique
  remarks   String?
  createdAt DateTime @default(now())
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("payments")
}

model AcademicSession {
  id                 String                 @id @default(cuid())
  schoolId           String
  name               String
  startDate          DateTime               @db.Date
  endDate            DateTime               @db.Date
  isCurrent          Boolean                @default(false)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  school             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  feeCharges         FeeCharge[]
  feeStructures      FeeStructure[]
  studentAssignments StudentFeeAssignment[]
  studentOverrides   StudentFeeOverride[]
  studentTransports  StudentTransport[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_sessions")
}

model FeeComponent {
  id               String               @id @default(cuid())
  schoolId         String
  name             String
  description      String?
  category         String?
  amount           Decimal              @db.Decimal(10, 2)
  frequency        FeeFrequency         @default(MONTHLY)
  isOptional       Boolean              @default(false)
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  chargeItems      FeeChargeItem[]
  school           School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  structureItems   FeeStructureItem[]
  studentOverrides StudentFeeOverride[]
  AdvanceLedger    AdvanceLedger[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("fee_components")
}

model FeeStructure {
  id                 String                 @id @default(cuid())
  schoolId           String
  name               String
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  description        String?
  sessionId          String
  status             String                 @default("ACTIVE")
  classAssignments   ClassFeeStructure[]
  items              FeeStructureItem[]
  school             School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session            AcademicSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentAssignments StudentFeeAssignment[]

  @@index([schoolId])
  @@index([sessionId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  componentId String
  structureId String
  amount      Decimal?     @db.Decimal(10, 2)
  component   FeeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([structureId, componentId])
  @@map("fee_structure_items")
}

model ClassFeeStructure {
  id          String       @id @default(cuid())
  classId     String
  structureId String
  createdAt   DateTime     @default(now())
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  structure   FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([classId, structureId])
  @@map("class_fee_structures")
}

model StudentFeeAssignment {
  id          String          @id @default(cuid())
  studentId   String
  sessionId   String
  structureId String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  session     AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  structure   FeeStructure    @relation(fields: [structureId], references: [id], onDelete: Cascade)
  student     Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId])
  @@index([studentId])
  @@map("student_fee_assignments")
}

model StudentFeeOverride {
  id             String          @id @default(cuid())
  studentId      String
  sessionId      String
  componentId    String
  discountAmount Decimal         @default(0) @db.Decimal(10, 2)
  isExempt       Boolean         @default(false)
  amount         Decimal?        @db.Decimal(10, 2)
  remarks        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  component      FeeComponent    @relation(fields: [componentId], references: [id], onDelete: Cascade)
  session        AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, sessionId, componentId])
  @@index([studentId])
  @@map("student_fee_overrides")
}

model FeeCharge {
  id        String          @id @default(cuid())
  schoolId  String
  studentId String
  sessionId String
  title     String
  dueDate   DateTime        @db.Date
  status    FeeStatus       @default(PENDING)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  items     FeeChargeItem[]
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([sessionId])
  @@index([schoolId, status, dueDate])
  @@index([studentId, schoolId, status])
  @@map("fee_charges")
}

model FeeChargeItem {
  id          String              @id @default(cuid())
  chargeId    String
  componentId String
  amount      Decimal             @db.Decimal(10, 2)
  paidAmount  Decimal             @default(0) @db.Decimal(10, 2)
  status      FeeStatus           @default(PENDING)
  createdAt   DateTime            @default(now())
  charge      FeeCharge           @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  component   FeeComponent        @relation(fields: [componentId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@unique([chargeId, componentId])
  @@index([chargeId, status])
  @@index([componentId, status])
  @@map("fee_charge_items")
}

model PaymentTransaction {
  id          String              @id @default(cuid())
  schoolId    String
  studentId   String
  amount      Decimal             @db.Decimal(10, 2)
  method      PaymentMethod       @default(CASH)
  reference   String?
  receiptNo   String              @unique
  date        DateTime            @default(now())
  status      String              @default("SUCCESS")
  remarks     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  allocations PaymentAllocation[]
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([schoolId, date])
  @@index([studentId, date])
  @@map("payment_transactions")
}

model PaymentAllocation {
  id           String             @id @default(cuid())
  paymentId    String
  chargeItemId String
  amount       Decimal            @db.Decimal(10, 2)
  createdAt    DateTime           @default(now())
  chargeItem   FeeChargeItem      @relation(fields: [chargeItemId], references: [id], onDelete: Cascade)
  payment      PaymentTransaction @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([chargeItemId])
  @@map("payment_allocations")
}

model AdvanceLedger {
  id          String        @id @default(cuid())
  studentId   String
  componentId String?
  amount      Decimal       @db.Decimal(10, 2)
  description String?
  createdAt   DateTime      @default(now())
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  component   FeeComponent? @relation(fields: [componentId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([componentId])
  @@map("advance_ledgers")
}

model Notice {
  id            String         @id @default(cuid())
  schoolId      String
  title         String
  content       String
  priority      NoticePriority @default(MEDIUM)
  targetClassId String?
  publishedById String
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  publishedBy   User           @relation(fields: [publishedById], references: [id])
  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("notices")
}

model Assignment {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String
  sectionId   String
  teacherId   String
  title       String
  description String?
  dueDate     DateTime
  fileUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  class       Class    @relation(fields: [classId], references: [id])
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  section     Section  @relation(fields: [sectionId], references: [id])
  teacher     Teacher  @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([classId, sectionId])
  @@map("assignments")
}

enum UserRole {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  ACCOUNTANT
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum FeeStatus {
  PAID
  PENDING
  OVERDUE
  WAIVED
  PARTIAL
}

enum FeeFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  ONE_TIME
  CUSTOM
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  NEFT
  RTGS
  IMPS
  CHEQUE
  DEBIT_CARD
  CREDIT_CARD
  ONLINE
  OTHER
}

enum NoticePriority {
  LOW
  MEDIUM
  HIGH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otps")
}

model ExpenseCategory {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  name        String    
  description String?
  expenses    Expense[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([schoolId, name])
  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(cuid())
  schoolId        String
  school          School          @relation(fields: [schoolId], references: [id])
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount          Decimal         @db.Decimal(10, 2)
  date            DateTime        @default(now())
  title           String          
  description     String?         
  paymentMethod   PaymentMethod   
  referenceNo     String?         
  receiptUrl      String?         
  recordedById    String?
  recordedBy      User?           @relation(fields: [recordedById], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([schoolId])
  @@index([categoryId])
  @@index([schoolId, date])
  @@map("expenses")
}

// ─── Transport Management ──────────────────────────────────────────────────

enum VehicleType {
  BUS
  VAN
  RICKSHAW
}

enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum RouteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransportEnrollmentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum TransportTripType {
  TWO_WAY
  PICKUP_ONLY
  DROP_ONLY
}

model Vehicle {
  id             String          @id @default(cuid())
  schoolId       String
  registrationNo String
  type           VehicleType     @default(BUS)
  model          String?
  capacity       Int
  driverName     String
  driverPhone    String
  helperName     String?
  helperPhone    String?
  status         VehicleStatus   @default(ACTIVE)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  routes         TransportRoute[]
  enrollments    StudentTransport[]
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, registrationNo])
  @@index([schoolId])
  @@map("vehicles")
}

model TransportRoute {
  id               String             @id @default(cuid())
  schoolId         String
  name             String
  code             String?
  vehicleId        String?
  startPoint       String
  endPoint         String
  defaultRatePerKm Decimal            @default(100.00) @db.Decimal(10, 2)
  flatRate         Decimal?           @db.Decimal(10, 2)
  status           RouteStatus        @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  vehicle          Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  school           School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stops            RouteStop[]
  enrollments      StudentTransport[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("transport_routes")
}

model RouteStop {
  id                   String             @id @default(cuid())
  routeId              String
  stopName             String
  sequenceOrder        Int
  pickupTime           String?
  dropTime             String?
  latitude             Float?
  longitude            Float?
  distanceFromSchoolKm Decimal            @default(0.0) @db.Decimal(6, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  route                TransportRoute     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  enrollments          StudentTransport[]

  @@index([routeId])
  @@map("route_stops")
}

model StudentTransport {
  id              String                    @id @default(cuid())
  schoolId        String
  studentId       String
  sessionId       String
  routeId         String
  stopId          String
  vehicleId       String?
  tripType        TransportTripType         @default(TWO_WAY)
  distanceKm      Decimal                   @db.Decimal(6, 2)
  monthlyFee      Decimal                   @db.Decimal(10, 2)
  status          TransportEnrollmentStatus @default(ACTIVE)
  startDate       DateTime                  @default(now())
  endDate         DateTime?
  notes           String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  school          School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student         Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session         AcademicSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  route           TransportRoute            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop            RouteStop                 @relation(fields: [stopId], references: [id], onDelete: Cascade)
  vehicle         Vehicle?                  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@unique([studentId, sessionId])
  @@index([schoolId])
  @@index([sessionId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([schoolId, status])
  @@map("student_transports")
}

